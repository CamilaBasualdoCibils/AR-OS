{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach: VISR Boot (VM :2345)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/src/Boot/VisrBoot",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "customLaunchSetupCommands": [
        {
          "description": "Connect to the VISR Boot extended-remote server",
          "text": "-target-select extended-remote 127.0.0.1:2345",
          "ignoreFailures": false
        },
        {
          "description": "Select the guest VisrBoot executable",
          "text": "-interpreter-exec console \"set remote exec-file /run/current-system/sw/bin/VisrBoot\"",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-run",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "targetArchitecture": "x64"
    },
    {
      "name": "Attach: VISR Login (VM :2346)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/VISR/Server/Login/VisrLogin",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "customLaunchSetupCommands": [
        {
          "description": "Connect to the VISR Login extended-remote server",
          "text": "-target-select extended-remote 127.0.0.1:2346",
          "ignoreFailures": false
        },
        {
          "description": "Select the guest VisrLogin executable",
          "text": "-interpreter-exec console \"set remote exec-file /run/current-system/sw/bin/VisrLogin\"",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "exec-run",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "targetArchitecture": "x64"
    },
    {
      "name": "Attach: VISR Desktop (VM :2347)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/VISR/Server/Desktop/VisrDesktop",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "customLaunchSetupCommands": [
        {
          "description": "Connect to the VISR Desktop extended-remote server",
          "text": "-target-select extended-remote 127.0.0.1:2347",
          "ignoreFailures": false
        },
        {
          "description": "Attach to the running VisrDesktop service process",
          "text": "-target-attach ${input:visrDesktopPid}",
          "ignoreFailures": false
        }
      ],
      "launchCompleteCommand": "None",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "targetArchitecture": "x64"
    }
  ],
  "inputs": [
    {
      "id": "visrDesktopPid",
      "type": "promptString",
      "description": "VisrDesktop PID: ssh -p 2222 aros@127.0.0.1 systemctl show -p MainPID --value visr-desktop",
      "default": "0"
    }
  ]
}
